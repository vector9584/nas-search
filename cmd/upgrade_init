#!/bin/bash
### 升级前回调 — 停止服务并清理残留

TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/nas-search/target}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/vol1/@appdata/nas-search}"

"${TRIM_APPDEST}/cmd/main" stop 2>/dev/null || true
pkill -9 -f "nas-search.*datasette" 2>/dev/null || true
sleep 1
rm -f "${TRIM_APPDEST}/nas-search.sock" 2>/dev/null || true
rm -f "${TRIM_PKGVAR}/nas-search.pid" 2>/dev/null || true

exit 0
